{
    "manifest_version": 3,
    "name": "CuratorLingua",
    "version": "1.0",
    "description": "A highlight text and translate extension build for minimalistic and simple users",
    "permissions": [
        "activeTab",
        "scripting"
    ],
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["content.js"],
            "css": ["content.css"]
        }
    ]
}